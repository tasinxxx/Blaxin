{
  "build": {
    "beforeBuildCommand": "bash ../scripts/bundle-sync-guard.sh"
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
